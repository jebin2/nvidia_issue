#!/usr/bin/env bash
# gpu-watchdog - detect the mode-H silent channel hang and tell you about it.
#
# Mode H signature (see ~/nvidia_issue/GITHUB_ISSUE_DRAFT.md): the GPU reports
# ~100% utilization at ~0% memory-controller traffic while drawing idle power,
# with a client still holding VRAM. Nothing is executing; a context was
# submitted and will never retire. The driver does not notice and never
# recovers, so the only fix is killing the client that owns the context.
#
# By default this only NOTIFIES - it does not kill anything. A game closing
# itself without warning is worse than being told why it froze. Set
# ACTION=kill to have it run gpu-unstick automatically instead.
#
# The state never resolves on its own, so this waits for the signature to hold
# for CONFIRM_SAMPLES consecutive polls before saying anything. No real workload
# sits at 100% utilization with 0% memory traffic at idle power for that long -
# that combination is self-contradictory, which is the basis of the diagnosis.
#
# Usage:  gpu-watchdog          run forever (what the systemd unit does)
#         gpu-watchdog --once   sample once, report, exit (for testing)
#         ACTION=kill gpu-watchdog     auto-recover instead of notifying

set -uo pipefail

POLL_SEC=3
CONFIRM_SAMPLES=10
UTIL_MIN=90
MEMTRAFFIC_MAX=2
POWER_MAX_W=25
VRAM_MIN_MIB=500
SMI_TIMEOUT=10

ACTION="${ACTION:-notify}"

# systemd user services do NOT inherit an interactive shell's PATH, and
# ~/.local/bin is typically absent from it - so resolve the helper next to this
# script rather than trusting PATH. UNSTICK= overrides for testing.
if [ -z "${UNSTICK:-}" ]; then
    _self_dir="$(dirname "$(readlink -f "$0")")"
    if [ -x "${_self_dir}/gpu-unstick" ]; then
        UNSTICK="${_self_dir}/gpu-unstick"
    else
        UNSTICK="gpu-unstick"
    fi
fi

ONCE=0
if [ "${1:-}" = "--once" ]; then
    ONCE=1
fi

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*"
}

sample() {
    timeout "$SMI_TIMEOUT" nvidia-smi --query-gpu=utilization.gpu,utilization.memory,power.draw,memory.used --format=csv,noheader,nounits 2>/dev/null
}

# Name of the client holding the GPU, for the notification text.
culprit() {
    timeout "$SMI_TIMEOUT" nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null \
        | awk -F', *' '$3 + 0 >= 500 && $2 !~ /kwin_wayland|Xorg|Xwayland|gnome-shell|Hyprland|plasmashell/ { n=split($2, p, /[\\\/]/); printf "%s (pid %s, %s MiB)\n", p[n], $1, $3; exit }'
}

notify() {
    local who="$1"
    local title="GPU wedged - the game will not recover"
    local body
    body="${who:-A client} is holding the GPU.

The GPU reports 100% busy at 0% memory traffic on idle power: a context was submitted that will never complete. The driver does not detect this and will not recover it on its own.

Run this in a terminal:
    gpu-unstick

No reboot needed."

    notify-send -u critical -a "GPU Watchdog" -i dialog-warning "$title" "$body" 2>/dev/null \
        || log "  (notify-send failed - is a notification daemon running?)"
}

# If the GPU has been removed from the bus (nvidia-blackout), there is nothing
# to watch and every poll would misreport "mode F/I, needs a power-cycle".
# Exit cleanly so the systemd unit records a success rather than a crash loop.
if ! lspci -nn 2>/dev/null | grep -i '10de:' > /dev/null; then
    log "No NVIDIA device on the PCI bus — nothing to watch. Exiting."
    log "  (disabled by nvidia-blackout? check: nvidia-blackout status)"
    exit 0
fi

streak=0
announced=0

while true; do
    row="$(sample)"

    if [ -z "$row" ]; then
        # nvidia-smi hanging or refusing means mode F or I: the GPU is dead
        # below the level any kill can reach. Say so; do not flail.
        log "nvidia-smi unresponsive - mode F/I, needs a power-cycle. Not acting."
        if [ "$announced" -eq 0 ]; then
            notify-send -u critical -a "GPU Watchdog" -i dialog-error \
                "GPU is unreachable" \
                "nvidia-smi is not responding. This is a PMU halt (mode F/I), not a recoverable hang.

Killing processes will not help. A full power-off is required - a warm reboot will not clear it." 2>/dev/null
            announced=1
        fi
        streak=0
        if [ "$ONCE" -eq 1 ]; then
            exit 2
        fi
        sleep $((POLL_SEC * 10))
        continue
    fi

    IFS=',' read -r util mem power vram <<< "${row// /}"
    util="${util%%.*}"
    mem="${mem%%.*}"
    power="${power%%.*}"
    vram="${vram%%.*}"

    if [ "$ONCE" -eq 1 ]; then
        log "sample: util=${util}% mem-traffic=${mem}% power=${power}W vram=${vram}MiB"
    fi

    hung=0
    if [ "${util:-0}" -ge "$UTIL_MIN" ] && [ "${mem:-99}" -le "$MEMTRAFFIC_MAX" ]; then
        if [ "${power:-999}" -le "$POWER_MAX_W" ] && [ "${vram:-0}" -ge "$VRAM_MIN_MIB" ]; then
            hung=1
        fi
    fi

    if [ "$hung" -eq 1 ]; then
        streak=$((streak + 1))
        log "suspect ${streak}/${CONFIRM_SAMPLES}: util=${util}% mem=${mem}% ${power}W ${vram}MiB"
    else
        if [ "$streak" -gt 0 ]; then
            log "cleared (util=${util}% mem=${mem}% ${power}W) - not a hang"
        fi
        streak=0
        announced=0          # episode over; allow a fresh notification next time
    fi

    if [ "$streak" -ge "$CONFIRM_SAMPLES" ] && [ "$announced" -eq 0 ]; then
        who="$(culprit)"
        log "mode H confirmed after $((CONFIRM_SAMPLES * POLL_SEC))s - ${who:-unknown client}"
        announced=1

        if [ "$ACTION" = "kill" ]; then
            log "ACTION=kill - running ${UNSTICK}"
            if ! command -v "$UNSTICK" >/dev/null 2>&1 && [ ! -x "$UNSTICK" ]; then
                log "  ERROR: ${UNSTICK} not found or not executable - cannot recover"
            else
                "$UNSTICK" 2>&1 | while IFS= read -r line; do log "  ${line}"; done
            fi
            announced=0
            sleep $((POLL_SEC * 5))
        else
            log "  notifying - run 'gpu-unstick' to recover (set ACTION=kill for automatic)"
            notify "$who"
        fi
    fi

    if [ "$ONCE" -eq 1 ]; then
        log "(--once: single sample taken, exiting)"
        exit 0
    fi

    sleep "$POLL_SEC"
done
