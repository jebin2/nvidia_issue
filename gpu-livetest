#!/usr/bin/env bash
# gpu-livetest — characterise the dGPU from a live USB session.
#
# Run this from a live ISO to answer one question: does this GPU misbehave
# under a driver other than NVIDIA's own? The failure modes in
# GITHUB_ISSUE_DRAFT.md all live in NVIDIA's driver and its GSP/PMU firmware
# path. A live Arch/Omarchy ISO ships no NVIDIA driver — only
# linux-firmware-nvidia, the GSP blobs — so it binds nouveau instead.
#
#   nouveau stable            -> the bug is in NVIDIA's driver. Report upstream.
#   nouveau faults on GSP too -> firmware or silicon. No driver will fix it.
#
# Both outcomes are useful. The point is to come back with comparable numbers
# rather than an impression, so this prints a fixed report and saves a copy.
#
# Usage:  gpu-livetest            inspect only, no load
#         gpu-livetest --load     also run a Vulkan/GL load for LOAD_SECS
#         LOAD_SECS=300 gpu-livetest --load
#
# Results are written to OUT_DIR, which defaults to the installed system at
# /mnt/host/home/jebin/nvidia_issue/livetest so they outlive the live session.
# Each run is tagged with the boot id, so repeated boots do not overwrite
# each other — mode F only shows up across several boots.

set -uo pipefail

LOAD_SECS="${LOAD_SECS:-120}"
# A live session's /tmp is RAM and dies with the reboot. Point OUT_DIR at the
# installed system (mounted from the live session) so the results survive to be
# read back there. Falls back to /tmp if that directory is not writable.
OUT_DIR="${OUT_DIR:-/mnt/host/home/jebin/nvidia_issue/livetest}"
if ! mkdir -p "$OUT_DIR" 2>/dev/null || [ ! -w "$OUT_DIR" ]; then
    echo "warning: $OUT_DIR is not writable — results will go to /tmp and will" >&2
    echo "         NOT survive the reboot. Mount the installed system first:" >&2
    echo "         sudo mount -o subvol=/@ /dev/nvme0n1p2 /mnt/host" >&2
    OUT_DIR=/tmp
fi
OUT="$OUT_DIR/gpu-livetest-$(date +%Y%m%d-%H%M%S)-boot$(cat /proc/sys/kernel/random/boot_id 2>/dev/null | cut -c1-8).txt"
DO_LOAD=0
NO_GPU=0
[ "${1:-}" = "--load" ] && DO_LOAD=1

# dmesg is often restricted to root; fall back rather than silently showing
# nothing, because "no faults found" and "could not read the log" look alike.
klog() {
    if dmesg 2>/dev/null | head -1 >/dev/null 2>&1 && [ -n "$(dmesg 2>/dev/null)" ]; then
        dmesg 2>/dev/null
    elif command -v sudo >/dev/null 2>&1; then
        sudo dmesg 2>/dev/null
    fi
}

hdr() { printf '\n== %s %s\n' "$1" "$(printf '%.0s-' $(seq 1 $((60 - ${#1}))))"; }
kv()  { printf '  %-22s %s\n' "$1" "${2:-n/a}"; }

report() {

hdr "identity"
kv "date"            "$(date '+%F %T %Z')"
kv "live ISO"        "$(cat /run/archiso/bootmnt/arch/version 2>/dev/null || echo 'not archiso / unknown')"
kv "kernel"          "$(uname -r)"
kv "product"         "$(cat /sys/class/dmi/id/product_name 2>/dev/null)"
kv "BIOS"            "$(cat /sys/class/dmi/id/bios_version 2>/dev/null) ($(cat /sys/class/dmi/id/bios_date 2>/dev/null))"

hdr "is the GPU on the bus"
# Captured, not piped into grep -q: grep -q closes the pipe, lspci dies of
# SIGPIPE, and under pipefail a successful match becomes a failed test.
on_bus=$(timeout 20 lspci -nn 2>/dev/null | grep -i '10de:')
lspci_rc=$?
if [ "$lspci_rc" -eq 124 ]; then
    kv "verdict" "lspci TIMED OUT reading PCI config space"
    kv "" "The GPU is not answering on the bus. Reading its config space is what"
    kv "" "wakes it from D3cold, so this IS the resume failure, not a side effect."
    kv "" "Check: dmesg | grep -iE 'nouveau|gsp' | tail -40"
    NO_GPU=1
    return
fi
if [ -n "$on_bus" ]; then
    printf '%s\n' "$on_bus" | sed 's/^/  /'
else
    kv "verdict" "NO NVIDIA DEVICE on the bus"
    kv "" "In a live session: the dGPU is disabled in BIOS, or there is a MUX setting."
    kv "" "On the installed system: nvidia-blackout is probably active."
    NO_GPU=1
    return
fi

hdr "which driver is bound"
for d in $(timeout 20 lspci -D 2>/dev/null | awk '/NVIDIA/ {print $1}'); do
    drv="$(basename "$(readlink -f "/sys/bus/pci/devices/$d/driver" 2>/dev/null)" 2>/dev/null)"
    # With nothing bound, the symlink does not exist and readlink -f echoes the
    # path back, so basename yields the literal "driver" — which reads as a
    # driver named "driver". That is exactly the case worth seeing clearly.
    [ -L "/sys/bus/pci/devices/$d/driver" ] || drv="NONE BOUND (probe failed?)"
    kv "$d" "$drv"
    kv "  power_state" "$(cat "/sys/bus/pci/devices/$d/power_state" 2>/dev/null)"
done
kv "modules loaded" "$(lsmod | awk '/^(nvidia|nouveau)/ {printf "%s ", $1}' || echo none)"

hdr "GSP firmware"
# nouveau on Ada REQUIRES GSP, and it loads the same blobs NVIDIA's driver
# uses. If GSP faults here too, that implicates the firmware, not the driver.
local gsp
gsp=$(klog | grep -iE 'gsp|GSP-RM' | tail -15)
[ -n "$gsp" ] && printf '%s\n' "$gsp" | sed 's/^/  /' || kv "verdict" "no GSP messages in the kernel log"

hdr "DRM"
for c in /sys/class/drm/card[0-9]; do
    [ -e "$c/device/uevent" ] || continue
    kv "${c##*/}" "$(sed -n 's/^DRIVER=//p' "$c/device/uevent" 2>/dev/null)"
done
for c in /sys/class/drm/card*-*; do
    [ -e "$c/status" ] || continue
    printf '  %-22s status=%s enabled=%s\n' "${c##*/}" \
        "$(cat "$c/status" 2>/dev/null)" "$(cat "$c/enabled" 2>/dev/null)"
done

hdr "render APIs"
if command -v vulkaninfo >/dev/null 2>&1; then
    vulkaninfo --summary 2>/dev/null | grep -E 'deviceName|driverName|driverInfo|apiVersion' | sed 's/^[[:space:]]*/  /'
else
    kv "vulkaninfo" "MISSING (pacman -Sy vulkan-tools)"
fi
if command -v glxinfo >/dev/null 2>&1; then
    glxinfo -B 2>/dev/null | grep -E 'OpenGL renderer|OpenGL version|Device' | sed 's/^[[:space:]]*/  /'
else
    kv "glxinfo" "MISSING (pacman -Sy mesa-utils)"
fi

hdr "fault scan"
local faults
faults=$(klog | grep -iE 'Xid |NVRM|nouveau.*(fault|timeout|error|TRAP|hang)|GSP.*(error|crash|halt|timeout)|r535_gsp|gsp: .*(fail|timeout)|PMU halt|PMU.*halted|gpu hung|ring.*timeout|disp: init failed|Client resume failed|runtime_resume.*(fail|-110)')
if [ -n "$faults" ]; then
    printf '%s\n' "$faults" | tail -40 | sed 's/^/  /'
    kv "count" "$(printf '%s\n' "$faults" | wc -l) matching lines"
else
    kv "verdict" "CLEAN — no Xid, NVRM, GSP or nouveau faults logged"
fi

}

load_test() {
    hdr "load test (${LOAD_SECS}s)"
    local before after app=""
    before=$(klog | grep -icE 'Xid |NVRM|nouveau.*(fault|timeout|error|TRAP|hang)|GSP.*(error|crash|halt|timeout)|r535_gsp|gsp: .*(fail|timeout)|PMU halt|PMU.*halted|gpu hung|ring.*timeout|disp: init failed|Client resume failed|runtime_resume.*(fail|-110)')

    for cand in vkcube glxgears; do
        command -v "$cand" >/dev/null 2>&1 && { app="$cand"; break; }
    done
    if [ -z "$app" ]; then
        kv "verdict" "no vkcube or glxgears available (pacman -Sy vulkan-tools mesa-utils)"
        return
    fi

    kv "running" "$app for ${LOAD_SECS}s"
    "$app" >/dev/null 2>&1 &
    local pid=$!
    local elapsed=0
    while [ "$elapsed" -lt "$LOAD_SECS" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            kv "RESULT" "$app DIED after ${elapsed}s — that is a reproduction"
            break
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    kill -9 "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null

    after=$(klog | grep -icE 'Xid |NVRM|nouveau.*(fault|timeout|error|TRAP|hang)|GSP.*(error|crash|halt|timeout)|r535_gsp|gsp: .*(fail|timeout)|PMU halt|PMU.*halted|gpu hung|ring.*timeout|disp: init failed|Client resume failed|runtime_resume.*(fail|-110)')
    kv "fault lines before" "$before"
    kv "fault lines after"  "$after"
    if [ "$after" -gt "$before" ]; then
        kv "RESULT" "NEW FAULTS under load — reproduced on this driver"
        klog | grep -iE 'Xid |NVRM|nouveau.*(fault|timeout|error|TRAP|hang)|GSP.*(error|crash|halt|timeout)|r535_gsp|gsp: .*(fail|timeout)|PMU halt|PMU.*halted|gpu hung|ring.*timeout|disp: init failed|Client resume failed|runtime_resume.*(fail|-110)' | tail -15 | sed 's/^/  /'
    else
        kv "RESULT" "survived ${LOAD_SECS}s with no new faults"
    fi
}

{
    echo "gpu-livetest — dGPU characterisation from a live session"
    report
    [ "$DO_LOAD" = 1 ] && [ "$NO_GPU" = 0 ] && load_test
    echo
    echo "Saved to: $OUT"
} 2>&1 | stdbuf -oL tee "$OUT"
sync 2>/dev/null

# The summary cannot show a stack trace, and that is where the answer was last
# time. Keep the whole log beside it.
klog > "${OUT%.txt}-dmesg.txt" 2>/dev/null && \
    echo "Full kernel log: ${OUT%.txt}-dmesg.txt"
sync 2>/dev/null
