[Unit]
Description=Lock NVIDIA GPU clocks (workaround: PMU firmware crash on memory p-state transitions, RTX 4050 Laptop)
# Run BEFORE the login screen: kwin_wayland probes the dGPU as soon as the session
# starts, and on 2026-07-03 the PMU halted (Xid 62/158) ~10 s after boot while kwin
# was already up. Locking clocks before any client exists means the one unavoidable
# memory p-state ramp happens with zero GPU traffic.
Before=display-manager.service

[Service]
Type=oneshot
# Wait up to 60s for the nvidia driver to be up (it loads via udev after root mount)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/nvidia-smi >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/nvidia-smi -pm 1
ExecStart=/usr/bin/nvidia-smi -lmc 8001
ExecStart=/usr/bin/nvidia-smi -lgc 210,1500
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
